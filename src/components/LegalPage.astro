---
interface Props {
	title: string;
	updated?: string;
}

const { title, updated } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
	<p class="text-sm text-zinc-500">
		Last updated: {updated ?? new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
	</p>
	<h1 class="mt-3 text-3xl font-semibold tracking-tight">{title}</h1>
	<div class="prose prose-zinc mt-8 max-w-none dark:prose-invert">
		<slot />
	</div>
</section>