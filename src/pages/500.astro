---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Something Went Wrong – Bulk HEIC to JPG Converter"
	description="An unexpected error occurred. Please try again."
>
	<section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center sm:px-6">
		<p class="text-6xl font-semibold tracking-tight">500</p>
		<h1 class="mt-4 text-2xl font-semibold">Something went wrong</h1>
		<p class="mt-3 text-zinc-600 dark:text-zinc-300">
			An unexpected error occurred. Please refresh the page and try again.
		</p>
		<a
			href="/"
			class="mt-8 inline-flex items-center justify-center rounded-lg bg-zinc-900 px-6 py-3 text-sm font-medium text-white transition hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200"
		>
			Back to the converter
		</a>
	</section>
</Layout>